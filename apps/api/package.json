{
  "name": "@vaultstack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "worker:cleanup": "tsx src/workers/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/ --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.integration.test.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/lib-storage": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@prisma/client": "^6.1.0",
    "@vaultstack/auth": "workspace:*",
    "@vaultstack/config": "workspace:*",
    "@vaultstack/database": "workspace:*",
    "@vaultstack/email": "workspace:*",
    "@vaultstack/logger": "workspace:*",
    "@vaultstack/openapi": "workspace:*",
    "@vaultstack/startup": "workspace:*",
    "@vaultstack/types": "workspace:*",
    "@vaultstack/validation": "workspace:*",
    "bullmq": "^5.34.5",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.2",
    "prisma": "^6.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vaultstack/testing": "workspace:*",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
