# Copy to /srv/vaultstack/config/compose.env and keep mode 0600.
COMPOSE_PROJECT_NAME=vaultstack

# Build context used by docker-compose.prod.yml (install.sh rsyncs the repo here).
VAULTSTACK_BUILD_CONTEXT=/srv/vaultstack/compose/source
VAULTSTACK_MONITORING_CONFIG_DIR=/srv/vaultstack/monitoring

# Object data (LocalFilesystemStorageProvider). Prefer a dedicated disk.
VAULTSTACK_DATA_ROOT=/mnt/thanos-backup/vaultstack/data
VAULTSTACK_POSTGRES_DATA_ROOT=/mnt/thanos-backup/vaultstack/postgres
VAULTSTACK_REDIS_DATA_ROOT=/mnt/thanos-backup/vaultstack/redis

# Bind Caddy only to the LAN NIC so 127.0.0.1:80 stays free for Opsiva nginx.
VAULTSTACK_PUBLIC_IP=192.168.1.9

DASHBOARD_DOMAIN=vault.ivaultstack.com
API_DOMAIN=api.ivaultstack.com
S3_DOMAIN=s3.ivaultstack.com
VITE_API_URL=https://api.ivaultstack.com
CORS_ORIGINS=https://vault.ivaultstack.com

S3_ALLOW_PRIVATE_ENDPOINTS=false
S3_GATEWAY_ENABLED=true

# Redis password (generate with: openssl rand -hex 24)
# Must match requirepass in docker-compose.ivaultstack.yml
REDIS_PASSWORD=replace-with-openssl-rand-hex-24
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

VAULTSTACK_DATABASE_URL_FILE=/srv/vaultstack/config/secrets/database_url
VAULTSTACK_JWT_SECRET_FILE=/srv/vaultstack/config/secrets/jwt_secret
VAULTSTACK_POSTGRES_PASSWORD_FILE=/srv/vaultstack/config/secrets/postgres_password
VAULTSTACK_METRICS_TOKEN_FILE=/srv/vaultstack/config/secrets/metrics_token
VAULTSTACK_GRAFANA_ADMIN_PASSWORD_FILE=/srv/vaultstack/config/secrets/grafana_admin_password

POSTGRES_USER=vaultstack
POSTGRES_DB=vaultstack
LOG_LEVEL=info
