[Unit]
Description=VaultStack production Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/vaultstack/compose
# $$ → $ for bash. Systemd must not expand ${args[@]} itself.
ExecStart=/bin/bash -c 'set -euo pipefail; args=(--env-file /srv/vaultstack/config/compose.env -f /srv/vaultstack/compose/docker-compose.yml); if [[ -f /srv/vaultstack/compose/docker-compose.ivaultstack.yml ]]; then args+=(-f /srv/vaultstack/compose/docker-compose.ivaultstack.yml); fi; exec /usr/bin/docker compose "$${args[@]}" up --remove-orphans'
ExecStop=/bin/bash -c 'set -euo pipefail; args=(--env-file /srv/vaultstack/config/compose.env -f /srv/vaultstack/compose/docker-compose.yml); if [[ -f /srv/vaultstack/compose/docker-compose.ivaultstack.yml ]]; then args+=(-f /srv/vaultstack/compose/docker-compose.ivaultstack.yml); fi; exec /usr/bin/docker compose "$${args[@]}" down'
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
