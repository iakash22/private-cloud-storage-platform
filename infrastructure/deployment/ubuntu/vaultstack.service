[Unit]
Description=VaultStack production Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/vaultstack/compose
# Optional ivaultstack/THANOS override is included when present.
ExecStart=/bin/bash -c 'FILES=(-f /srv/vaultstack/compose/docker-compose.yml); [[ -f /srv/vaultstack/compose/docker-compose.ivaultstack.yml ]] && FILES+=(-f /srv/vaultstack/compose/docker-compose.ivaultstack.yml); exec /usr/bin/docker compose --env-file /srv/vaultstack/config/compose.env "${FILES[@]}" up --remove-orphans'
ExecStop=/bin/bash -c 'FILES=(-f /srv/vaultstack/compose/docker-compose.yml); [[ -f /srv/vaultstack/compose/docker-compose.ivaultstack.yml ]] && FILES+=(-f /srv/vaultstack/compose/docker-compose.ivaultstack.yml); exec /usr/bin/docker compose --env-file /srv/vaultstack/config/compose.env "${FILES[@]}" down'
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
