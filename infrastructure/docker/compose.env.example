# VaultStack production Docker Compose environment
#
# Local smoke test:
#   ./scripts/init-env.sh
#   docker compose --env-file infrastructure/docker/compose.env \
#     -f infrastructure/docker/docker-compose.prod.yml up -d --build
#
# Ubuntu server:
#   sudo cp infrastructure/deployment/ubuntu/compose.env.example \
#     /srv/vaultstack/config/compose.env
#   sudoedit /srv/vaultstack/config/compose.env

COMPOSE_PROJECT_NAME=vaultstack

# Git checkout used as Docker build context (local dev: repo root; Ubuntu: staged copy).
VAULTSTACK_BUILD_CONTEXT=/srv/vaultstack/compose/source
VAULTSTACK_MONITORING_CONFIG_DIR=/srv/vaultstack/monitoring
VAULTSTACK_DATA_ROOT=/srv/vaultstack/data

# Public DNS names — Caddy obtains TLS certificates for all three.
DASHBOARD_DOMAIN=vault.example.com
API_DOMAIN=api.vault.example.com
S3_DOMAIN=s3.example.com

# Baked into the dashboard image at build time.
VITE_API_URL=https://api.vault.example.com

# Must match the dashboard origin exactly (cookie + CSRF).
CORS_ORIGINS=https://vault.example.com

# Keep false unless a trusted operator intentionally configures a private S3 endpoint.
S3_ALLOW_PRIVATE_ENDPOINTS=false
S3_GATEWAY_ENABLED=true

# Docker secret file paths (never commit secret contents).
VAULTSTACK_DATABASE_URL_FILE=/srv/vaultstack/config/secrets/database_url
VAULTSTACK_JWT_SECRET_FILE=/srv/vaultstack/config/secrets/jwt_secret
VAULTSTACK_POSTGRES_PASSWORD_FILE=/srv/vaultstack/config/secrets/postgres_password
VAULTSTACK_METRICS_TOKEN_FILE=/srv/vaultstack/config/secrets/metrics_token
VAULTSTACK_GRAFANA_ADMIN_PASSWORD_FILE=/srv/vaultstack/config/secrets/grafana_admin_password

POSTGRES_USER=vaultstack
POSTGRES_DB=vaultstack
GRAFANA_ADMIN_USER=admin
LOG_LEVEL=info
