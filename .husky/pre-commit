#!/usr/bin/env sh
set -e

cd "$(dirname "$0")/.."

# Git for Windows (not WSL). WSL often sets WINDIR, so do not use that as a signal.
if uname -s 2>/dev/null | grep -qiE 'mingw|msys|cygwin'; then
  exec wsl.exe -d Ubuntu-24.04 -- bash -lc 'source "$HOME/.nvm/nvm.sh" && cd ~/projects/private-cloud-storage-platform && pnpm exec lint-staged'
fi

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  exec bash -c 'source "$HOME/.nvm/nvm.sh"; cd "$1"; pnpm exec lint-staged' _ "$(pwd)"
fi

pnpm exec lint-staged
