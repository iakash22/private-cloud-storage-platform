# VaultStack environment template
#
# Quick setup (generates .env + local prod compose.env + Docker secrets):
#   chmod +x scripts/init-env.sh && ./scripts/init-env.sh
#
# Manual setup: copy to .env and replace placeholder secrets.

# =============================================================================
# DEVELOPMENT — API, workers, and dashboard (pnpm dev)
# =============================================================================

# --- API core ---
NODE_ENV=development
API_HOST=0.0.0.0
# Use 5000 if 3000 is already taken; VITE_API_URL must match.
API_PORT=5000
LOG_LEVEL=info

# --- PostgreSQL (metadata only — never store file binaries here) ---
DATABASE_URL=postgresql://vaultstack:vaultstack_dev@localhost:5432/vaultstack

# --- Redis (BullMQ queues and caching) ---
REDIS_URL=redis://localhost:6379

# --- Auth (server-side only; min 32 characters for JWT_SECRET) ---
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-chars
SESSION_TTL_SECONDS=43200
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_SECONDS=60
# Browser origins for cookie auth. Defaults to localhost:5173 in dev if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (local filesystem is the primary production backend) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.vaultstack/storage
STORAGE_MAX_OBJECT_SIZE_BYTES=5368709120
STORAGE_MAX_REQUEST_SIZE_BYTES=67108864
STORAGE_MULTIPART_MIN_PART_SIZE_BYTES=5242880
STORAGE_MULTIPART_MAX_PARTS=10000
STORAGE_MAX_METADATA_BYTES=2048
STORAGE_MAX_KEY_LENGTH=1024
STORAGE_PRESIGNED_URL_TTL_SECONDS=900
STORAGE_UPLOAD_TTL_SECONDS=3600

# Multipart cleanup worker (run separately from the API):
#   pnpm --filter @vaultstack/api worker:cleanup

# --- S3-compatible integration (optional external provider) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
S3_ALLOW_PRIVATE_ENDPOINTS=false

# --- S3 gateway (SigV4-compatible API boundary) ---
S3_GATEWAY_ENABLED=false
S3_GATEWAY_REGION=vaultstack

# --- MinIO (optional — `docker compose --profile minio up -d`) ---
# MINIO_ROOT_USER=vaultstack_minio
# MINIO_ROOT_PASSWORD=
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=vaultstack_minio
# MINIO_SECRET_KEY=
# MINIO_BUCKET=vaultstack

# --- Backups ---
# MONGODB_URI=mongodb://localhost:27017
# BACKUP_DOCKER_VOLUME_PATHS=/var/lib/docker/volumes
BACKUP_TEMP_DIR=./.vaultstack/backups
BACKUP_MAX_CONCURRENT_JOBS=1
BACKUP_PROCESS_INLINE=false

# --- Workers (production Compose sets backup | artifact; dev uses all) ---
WORKER_ROLE=all

# --- Infrastructure monitoring (Phase 13) ---
DOCKER_SOCKET=/var/run/docker.sock
# INFRASTRUCTURE_DISK_PATHS=./.vaultstack/storage

# --- Observability (Phase 19) — bearer token for GET /metrics ---
# METRICS_TOKEN=

# --- Dashboard (Vite; loaded from repo root via apps/dashboard/vite.config.ts) ---
VITE_API_URL=http://localhost:5000

# =============================================================================
# PRODUCTION COMPOSE — use infrastructure/docker/compose.env (not this file)
# =============================================================================
# Secrets live in infrastructure/docker/secrets/ (or /srv/vaultstack/config/secrets
# on Ubuntu). Run scripts/init-env.sh or infrastructure/deployment/ubuntu/init-secrets.sh.
#
# See infrastructure/docker/compose.env.example and
# infrastructure/deployment/ubuntu/compose.env.example for production variables:
#   DASHBOARD_DOMAIN, API_DOMAIN, S3_DOMAIN, VITE_API_URL, CORS_ORIGINS,
#   VAULTSTACK_DATA_ROOT, VAULTSTACK_*_FILE, POSTGRES_USER, POSTGRES_DB
