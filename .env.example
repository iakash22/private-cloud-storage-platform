# VaultStack — copy to .env and adjust for local development

# API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL (metadata only — never store file binaries here)
DATABASE_URL=postgresql://vaultstack:vaultstack_dev@localhost:5432/vaultstack

# Redis (BullMQ queues and caching)
REDIS_URL=redis://localhost:6379

# JWT signing secret for optional bearer tokens (server-side only, min 32 characters)
JWT_SECRET=replace-with-a-long-random-jwt-secret-value

# Session cookie lifetime (default 12 hours). Browser auth is HTTP-only cookies, not localStorage.
# SESSION_TTL_SECONDS=43200
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# API_RATE_LIMIT_MAX=300
# API_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Storage (Phase 3)
# ---------------------------------------------------------------------------

# Which backend new organizations get by default: `local` or `s3`.
# The local Linux filesystem is the primary production backend.
STORAGE_DRIVER=local

# Root directory for object data. Server-generated paths only live below this.
# Development (host or WSL): a directory you own, e.g. inside the repo.
# Containerized development: /data, backed by the vaultstack_storage volume.
# Production: a real persistent mount, e.g. /srv/vaultstack/data
# Never a container writable layer, and never a hardcoded production path.
STORAGE_LOCAL_ROOT=./.vaultstack/storage

# Size and shape limits, centralized here rather than scattered through code.
# STORAGE_MAX_OBJECT_SIZE_BYTES=5368709120       # 5 GiB per object
# STORAGE_MAX_REQUEST_SIZE_BYTES=67108864        # 64 MiB per single request
# STORAGE_MULTIPART_MIN_PART_SIZE_BYTES=5242880  # 5 MiB, the S3 minimum
# STORAGE_MULTIPART_MAX_PARTS=10000
# STORAGE_MAX_METADATA_BYTES=2048
# STORAGE_MAX_KEY_LENGTH=1024

# Lifetimes for signed storage URLs. Keep these short.
# STORAGE_PRESIGNED_URL_TTL_SECONDS=900
# STORAGE_UPLOAD_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# S3-compatible integration (optional)
# ---------------------------------------------------------------------------
# Works against any S3-compatible endpoint: AWS S3, Cloudflare R2, Backblaze
# B2, MinIO, DigitalOcean Spaces, Wasabi. Leave unset to run purely on local
# filesystem storage.
#
# These are SERVER-SIDE ONLY. They are never sent to the browser; the browser
# only ever receives short-lived presigned URLs.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# S3-compatible gateway. Off by default until credentials are provisioned.
# S3_GATEWAY_ENABLED=false
# S3_GATEWAY_REGION=vaultstack

# ---------------------------------------------------------------------------
# MinIO — development and integration testing only
# ---------------------------------------------------------------------------
# MinIO is OPTIONAL and is not the core storage engine. It is started with
# `docker compose --profile minio up -d`, and these values are what that
# profile reads. Use throwaway development values only; never production
# credentials, and never commit a filled-in .env.
# MINIO_ROOT_USER=vaultstack_minio
# MINIO_ROOT_PASSWORD=
#
# Legacy per-service settings, still honoured as an S3_* fallback in dev.
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=vaultstack_minio
# MINIO_SECRET_KEY=
# MINIO_BUCKET=vaultstack

# Dashboard (Vite dev server — no secrets in frontend env vars)
VITE_API_URL=http://localhost:3000
