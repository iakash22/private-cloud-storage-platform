generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String
  disabledAt           DateTime?
  totpEnabledAt        DateTime?
  totpSecretCiphertext String?
  totpSecretNonce      String?
  totpBackupCodeHashes String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  userRoles         UserRole[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  sessions          Session[]
  teamMembers       TeamMember[]
  createdShareLinks        ShareLink[]
  createdProjects          Project[]           @relation("ProjectCreatedBy")
  createdBuilds            Build[]             @relation("BuildCreatedBy")
  createdBackupSchedules   BackupSchedule[]    @relation("BackupScheduleCreatedBy")
  createdBackupJobs        BackupJob[]         @relation("BackupJobCreatedBy")
  createdBackupRestoreJobs BackupRestoreJob[]  @relation("BackupRestoreCreatedBy")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  csrfHash      String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams     Team[]
  roles     Role[]
  userRoles UserRole[]
  apiKeys   ApiKey[]
  auditLogs AuditLog[]

  storageProviders StorageProvider[]
  buckets          Bucket[]
  storageObjects   StorageObject[]
  objectVersions   ObjectVersion[]
  uploads          Upload[]
  multipartUploads MultipartUpload[]
  storagePolicies  StoragePolicy[]
  shareLinks       ShareLink[]
  teamMembers      TeamMember[]
  serviceAccounts  ServiceAccount[]
  s3Credentials    S3AccessCredential[]
  projects           Project[]
  builds             Build[]
  artifacts          Artifact[]
  artifactVersions   ArtifactVersion[]
  backupSchedules    BackupSchedule[]
  backupJobs         BackupJob[]
  backupSnapshots    BackupSnapshot[]
  backupJobLogs      BackupJobLog[]
  backupRestoreJobs  BackupRestoreJob[]
  previewJobs        PreviewJob[]
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  shareLinks   ShareLink[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Membership used to enforce TEAM share visibility. A team name alone is not access.
model TeamMember {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId, organizationId])
  @@index([organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  keyHash        String    @unique
  prefix         String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  serviceAccountId String?
  action         String
  resourceType   String
  resourceId     String?
  result         String   @default("success")
  requestId      String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, result, createdAt])
  @@index([organizationId, resourceType, createdAt])
  @@index([userId])
  @@index([serviceAccountId])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Storage engine (Phase 3)
//
// PostgreSQL holds metadata only. Object bytes live in a StorageProvider
// (local filesystem by default, or any S3-compatible endpoint).
//
// The model is named StorageObject rather than Object because the generated
// Prisma client would otherwise export a type that shadows the TypeScript
// `Object` global.
// ---------------------------------------------------------------------------

enum StorageProviderType {
  LOCAL_FILESYSTEM
  S3_COMPATIBLE
}

enum StorageProviderStatus {
  ACTIVE
  DEGRADED
  DISABLED
}

enum BucketVersioningStatus {
  UNVERSIONED
  ENABLED
  SUSPENDED
}

enum ChecksumAlgorithm {
  NONE
  MD5
  SHA256
  CRC32
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETING
  COMPLETED
  FAILED
  ABORTED
  EXPIRED
}

enum MultipartUploadStatus {
  INITIATED
  UPLOADING
  COMPLETING
  COMPLETED
  ABORTED
  EXPIRED
}

enum StoragePolicyEffect {
  ALLOW
  DENY
}

enum StoragePolicyKind {
  ACCESS
  LIFECYCLE
}

enum StorageLifecycleAction {
  EXPIRE_CURRENT
  EXPIRE_NONCURRENT
  ABORT_INCOMPLETE_MULTIPART
  EXPIRE_TEMPORARY
}

model StorageProvider {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  type           StorageProviderType
  status         StorageProviderStatus @default(ACTIVE)
  isDefault      Boolean               @default(false)

  /// Non-secret provider settings only (dialect, endpoint, region, bucket, path
  /// style, TLS). Secret keys are never stored here. Vendor names live in this
  /// JSON as a dialect; business logic never branches on them.
  config Json @default("{}")

  /// Names a server-side credential set (for example env:S3). Organization-stored
  /// secrets use the encrypted columns instead.
  credentialRef String?

  /// Access key id is identifying metadata, not the secret. The secret is stored
  /// only as AES-256-GCM ciphertext with a dedicated nonce.
  accessKeyId      String?
  secretCiphertext String?
  secretNonce      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buckets          Bucket[]
  storageObjects   StorageObject[]
  objectVersions   ObjectVersion[]
  multipartUploads MultipartUpload[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Bucket {
  id                String                 @id @default(cuid())
  organizationId    String
  storageProviderId String
  name              String
  region            String?
  versioning        BucketVersioningStatus @default(UNVERSIONED)

  /// Server-generated physical namespace. Never derived from user input and
  /// never returned to clients.
  physicalPrefix String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageProvider  StorageProvider   @relation(fields: [storageProviderId], references: [id], onDelete: Restrict)
  objects          StorageObject[]
  objectVersions   ObjectVersion[]
  uploads          Upload[]
  multipartUploads MultipartUpload[]
  policies         StoragePolicy[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([storageProviderId])
}

model StorageObject {
  id                String @id @default(cuid())
  organizationId    String
  bucketId          String
  storageProviderId String

  /// User-controlled object key. Metadata only: it is never used to build a
  /// filesystem path.
  key String

  size              BigInt
  contentType       String            @default("application/octet-stream")
  etag              String
  checksumAlgorithm ChecksumAlgorithm @default(SHA256)
  checksum          String?

  /// Soft pointer to the current ObjectVersion. Kept relation-free to avoid a
  /// circular foreign key; ObjectVersion.isCurrent is the authoritative flag.
  currentVersionId String?

  /// True when the current version is a delete marker. Hidden from default listings.
  isDeleted Boolean @default(false)

  /// Server-generated physical location relative to the provider root.
  physicalKey String

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket          Bucket          @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  storageProvider StorageProvider @relation(fields: [storageProviderId], references: [id], onDelete: Restrict)
  versions         ObjectVersion[]
  shareLinks       ShareLink[]
  artifactVersions ArtifactVersion[]
  backupSnapshots  BackupSnapshot[]
  previewJobs      PreviewJob[]

  @@unique([bucketId, key])
  @@index([organizationId])
  @@index([bucketId, key])
  @@index([organizationId, createdAt])
  @@index([bucketId, isDeleted, key])
}

model PreviewJob {
  id             String   @id @default(cuid())
  organizationId String
  objectId       String
  kind           String
  status         String   @default("QUEUED")
  result         Json?
  outputObjectId String?
  error          String?
  converter      String?
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  object       StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([objectId, kind, status])
}

model ObjectVersion {
  id                String @id @default(cuid())
  organizationId    String
  objectId          String
  bucketId          String
  storageProviderId String

  /// VaultStack version identifier. Providers store opaque physical keys; this
  /// id is not an S3 version id even when the backend reports nativeVersioning.
  versionId String

  size              BigInt
  contentType       String            @default("application/octet-stream")
  etag              String
  checksumAlgorithm ChecksumAlgorithm @default(SHA256)
  checksum          String?
  physicalKey       String
  isCurrent         Boolean           @default(false)
  isDeleteMarker    Boolean           @default(false)
  metadata          Json?

  createdAt DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  object          StorageObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  bucket          Bucket          @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  storageProvider StorageProvider @relation(fields: [storageProviderId], references: [id], onDelete: Restrict)

  @@unique([objectId, versionId])
  @@index([organizationId])
  @@index([objectId, isCurrent])
  @@index([organizationId, objectId, versionId])
  @@index([bucketId, isCurrent, createdAt])
}

model Upload {
  id             String       @id @default(cuid())
  organizationId String
  bucketId       String
  userId         String?
  key            String
  status         UploadStatus @default(PENDING)

  contentType  String?
  declaredSize BigInt?

  /// SHA-256 of the single-use upload token. The plaintext token is returned
  /// once and never persisted.
  tokenHash String @unique

  /// Server-generated staging location, relative to the provider root.
  stagingKey String

  /// Populated for S3-compatible providers that hand out presigned uploads.
  providerUploadId String?

  receivedSize BigInt?
  checksum     String?
  objectId     String?
  failureCode  String?

  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket       Bucket       @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bucketId])
  @@index([status, expiresAt])
}

model MultipartUpload {
  id                String                @id @default(cuid())
  organizationId    String
  bucketId          String
  storageProviderId String
  userId            String?
  key               String
  status            MultipartUploadStatus @default(INITIATED)

  contentType  String?
  declaredSize BigInt?
  metadata     Json?

  /// Upload id issued by the underlying provider (S3 upload id, or a
  /// server-generated id for the local filesystem provider).
  providerUploadId String

  /// Server-generated staging directory for accumulated parts.
  stagingKey String

  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  completedAt    DateTime?
  failureCode    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket          Bucket          @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  storageProvider StorageProvider @relation(fields: [storageProviderId], references: [id], onDelete: Restrict)
  parts           MultipartPart[]

  @@unique([bucketId, providerUploadId])
  @@index([organizationId])
  @@index([organizationId, status, lastActivityAt])
  @@index([status, expiresAt])
}

model MultipartPart {
  id                String @id @default(cuid())
  multipartUploadId String
  partNumber        Int
  size              BigInt
  etag              String
  checksum          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  multipartUpload MultipartUpload @relation(fields: [multipartUploadId], references: [id], onDelete: Cascade)

  @@unique([multipartUploadId, partNumber])
  @@index([multipartUploadId])
}

/// ACCESS rows remain an authorization foundation and are not consulted at
/// request time. LIFECYCLE rows are evaluated by the lifecycle worker against
/// PostgreSQL metadata; providers only receive delete/abort of physical bytes.
model StoragePolicy {
  id             String              @id @default(cuid())
  organizationId String
  bucketId       String?
  name           String
  kind           StoragePolicyKind   @default(ACCESS)
  effect         StoragePolicyEffect @default(ALLOW)
  enabled        Boolean             @default(true)

  /// Permission keys such as storage.read or storage.upload (ACCESS policies).
  actions String[]

  /// Optional object key prefix the policy applies to.
  keyPrefix String?

  /// Age in days for LIFECYCLE rules. Unused for ACCESS policies.
  days Int?

  lifecycleAction StorageLifecycleAction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket       Bucket?      @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([bucketId])
  @@index([organizationId, kind, enabled])
}

enum ShareVisibility {
  PRIVATE
  TEAM
  ORGANIZATION
  PUBLIC_LINK
}

/// Time-limited object share. The public identifier is a high-entropy token;
/// sequential ShareLink ids are never used as access tokens.
model ShareLink {
  id              String @id @default(cuid())
  organizationId  String
  objectId        String
  createdByUserId String?
  teamId          String?

  /// SHA-256 of the share token. Plaintext tokens are never persisted.
  tokenHash   String @unique
  /// Non-secret prefix of the plaintext token, for owner identification only.
  tokenPrefix String

  visibility    ShareVisibility @default(PUBLIC_LINK)
  /// bcrypt hash when a share password is set. Plaintext is never stored.
  passwordHash  String?
  allowView     Boolean         @default(true)
  allowDownload Boolean         @default(true)
  maxDownloads  Int?

  expiresAt    DateTime?
  revokedAt    DateTime?
  lastAccessAt DateTime?
  accessCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  object       StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([objectId])
  @@index([teamId])
  @@index([organizationId, visibility])
  @@index([tokenPrefix])
}

/// Programmatic identity for S3 gateway access. Separate from browser users.
model ServiceAccount {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials  S3AccessCredential[]
  auditLogs    AuditLog[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// SigV4 signing credentials for the VaultStack S3 gateway. Secrets are stored
/// encrypted at rest; plaintext is returned only once at creation/rotation.
model S3AccessCredential {
  id                 String    @id @default(cuid())
  organizationId     String
  serviceAccountId   String
  accessKeyId        String    @unique
  secretCiphertext   String
  secretNonce        String
  permissions        String[]
  allowedBucketNames String[]  @default([])
  expiresAt          DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  requestCount       Int       @default(0)
  rotatedFromId      String?
  createdAt          DateTime  @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceAccount ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([serviceAccountId])
}

// ---------------------------------------------------------------------------
// CI/CD artifact control plane. Bytes still live in StorageProvider via
// StorageObject; these rows are metadata only.
// ---------------------------------------------------------------------------

enum ArtifactKind {
  GENERIC
  PACKAGE
  LOG
  ARCHIVE
  RELEASE
  BUNDLE
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ArtifactVersionStatus {
  PENDING
  AVAILABLE
  FAILED
}

model Project {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  /// Non-release artifact versions older than this many days are eligible for
  /// retention. Null means keep forever.
  retentionDays   Int?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  builds       Build[]
  artifacts    Artifact[]
  versions     ArtifactVersion[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Build {
  id              String      @id @default(cuid())
  organizationId  String
  projectId       String
  number          Int
  status          BuildStatus @default(QUEUED)
  title           String?
  gitRef          String?
  commitSha       String?
  createdByUserId String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("BuildCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  artifacts    Artifact[]
  versions     ArtifactVersion[]

  @@unique([projectId, number])
  @@index([organizationId])
  @@index([projectId])
}

model Artifact {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  buildId        String
  name           String
  kind           ArtifactKind @default(GENERIC)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  build        Build             @relation(fields: [buildId], references: [id], onDelete: Cascade)
  versions     ArtifactVersion[]

  @@unique([buildId, name])
  @@index([organizationId])
  @@index([projectId])
}

model ArtifactVersion {
  id              String                @id @default(cuid())
  organizationId  String
  projectId       String
  buildId         String
  artifactId      String
  version         Int
  versionLabel    String?
  status          ArtifactVersionStatus @default(PENDING)
  storageObjectId String?
  storageUploadId String?
  isCurrent       Boolean               @default(false)
  isRelease       Boolean               @default(false)
  releaseTag      String?
  releasedAt      DateTime?
  size            BigInt                @default(0)
  contentType     String                @default("application/octet-stream")
  checksum        String?
  etag            String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  build         Build          @relation(fields: [buildId], references: [id], onDelete: Cascade)
  artifact      Artifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  storageObject StorageObject? @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)

  @@unique([artifactId, version])
  @@unique([projectId, releaseTag])
  @@index([organizationId])
  @@index([artifactId, isCurrent])
  @@index([projectId, isRelease])
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Backup engine (Phase 11)
//
// PostgreSQL holds job/snapshot metadata only. Archive bytes live in a
// StorageObject (org bucket vs-backups) via StorageService.
// ---------------------------------------------------------------------------

enum BackupJobStatus {
  QUEUED
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum BackupTarget {
  POSTGRESQL
  MONGODB
  APP_CONFIG
  DOCKER_VOLUMES
  VAULTSTACK_METADATA
  VAULTSTACK_OBJECT_METADATA
}

enum BackupLogLevel {
  INFO
  WARN
  ERROR
}

model BackupSchedule {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  enabled         Boolean        @default(true)
  targets         BackupTarget[]
  intervalMinutes Int            @default(1440)
  retentionDays   Int?
  retentionCount  Int?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("BackupScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  jobs         BackupJob[]
  snapshots    BackupSnapshot[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([enabled, nextRunAt])
}

model BackupJob {
  id               String          @id @default(cuid())
  organizationId   String
  scheduleId       String?
  createdByUserId  String?
  status           BackupJobStatus @default(QUEUED)
  targets          BackupTarget[]
  progressPercent  Int             @default(0)
  currentStep      String?
  errorMessage     String?
  cancelRequested  Boolean         @default(false)
  retryOfJobId     String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("BackupJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  retryOf      BackupJob?      @relation("BackupJobRetry", fields: [retryOfJobId], references: [id], onDelete: SetNull)
  retries      BackupJob[]     @relation("BackupJobRetry")
  snapshot     BackupSnapshot?
  logs         BackupJobLog[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([scheduleId])
}

model BackupSnapshot {
  id                   String    @id @default(cuid())
  organizationId       String
  jobId                String    @unique
  scheduleId           String?
  storageObjectId      String?
  manifestChecksum     String
  size                 BigInt    @default(0)
  verifiedAt           DateTime?
  verificationPassed   Boolean   @default(false)
  verificationError    String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job           BackupJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  schedule      BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  storageObject StorageObject?  @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  restoreJobs   BackupRestoreJob[]

  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

model BackupJobLog {
  id             String         @id @default(cuid())
  organizationId String
  jobId          String
  level          BackupLogLevel @default(INFO)
  message        String
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          BackupJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([organizationId])
}

model BackupRestoreJob {
  id              String          @id @default(cuid())
  organizationId  String
  snapshotId      String
  createdByUserId String?
  status          BackupJobStatus @default(QUEUED)
  progressPercent Int             @default(0)
  currentStep     String?
  restorePlan     Json?
  errorMessage    String?
  cancelRequested Boolean         @default(false)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     BackupSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  createdBy    User?          @relation("BackupRestoreCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([snapshotId])
}
